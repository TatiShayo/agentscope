# AgentScope Environment Configuration Example
# Copy this file to .env and configure for your local or production deployment.

# ============================================================================
# OpenTelemetry Tracing & Collector Configuration
# ============================================================================
# OpenTelemetry Service Name
AGENTSCOPE_SERVICE_NAME=agentscope

# OTLP Collector gRPC Endpoint (default localhost:4317 for local Jaeger / Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# OTLP Insecure transport (true for local development, false for TLS)
OTEL_EXPORTER_OTLP_INSECURE=true

# Content Capture Mode: set to true to record prompts, completions, and tool outputs
# Default: false (metadata only, tokens, latency, status)
AGENTSCOPE_CAPTURE_CONTENT=false

# ============================================================================
# Jaeger & Observability Backend
# ============================================================================
# Jaeger HTTP REST API & UI Base URL
JAEGER_URL=http://localhost:16686

# Query Service Port (HTTP)
AGENTSCOPE_QUERY_PORT=8000

# ============================================================================
# Exporter Retry & Resilience Settings
# ============================================================================
# Maximum retry attempts when sending traces
AGENTSCOPE_EXPORT_MAX_RETRIES=3

# Initial retry backoff delay in seconds
AGENTSCOPE_EXPORT_INITIAL_BACKOFF=0.1

# Maximum retry backoff delay in seconds
AGENTSCOPE_EXPORT_MAX_BACKOFF=2.0

# In-memory buffer size for offline span queueing
AGENTSCOPE_EXPORT_MAX_BUFFER_SIZE=2048

# ============================================================================
# Governance, Audit & Ledger Paths
# ============================================================================
# Task Ledger JSON Path
TASK_LEDGER_PATH=TASK_LEDGER.json

# Signed Delegation Audit Log Path
AUDIT_LOG_PATH=AUDIT_LOG.jsonl

# Dispatch Rationale Log Path
DISPATCH_RATIONALE_PATH=DISPATCH_RATIONALE.jsonl

# Maximum Fix-Review Cycle Limit
AGENTSCOPE_CYCLE_CAP=3

# ============================================================================
# Model API Keys (Dummy placeholders for agent execution)
# ============================================================================
OPENAI_API_KEY=sk-mock-openai-key-dummy-value-1234567890abcdef
ANTHROPIC_API_KEY=sk-ant-mock-anthropic-key-dummy-value-1234567890abcdef
GEMINI_API_KEY=AIzaSyMockGeminiKeyDummyValue1234567890
DEEPSEEK_API_KEY=sk-mock-deepseek-key-dummy-value-1234567890abcdef
